{
  "manifest_version": 3,
  "name": "ClipRange",
  "version": "0.1.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["nativeMessaging", "notifications", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["i18n.js", "host-client.js", "content/youtube.js"],
      "css": ["content/youtube.css"]
    }
  ],
  "options_page": "options/options.html"
}
